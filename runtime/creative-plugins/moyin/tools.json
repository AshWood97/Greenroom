    "inputSchema": {
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string",
          "minLength": 1
        },
        "sceneId": {
          "type": "integer"
        },
        "frameType": {
          "type": "string",
          "enum": [
            "start",
            "end"
          ]
        },
        "variationType": {
          "type": "string",
          "enum": [
            "angle",
            "composition",
            "moment"
          ]
        },
        "useCharacterRef": {
