        },
        "splitTaskId": {
          "type": "string",
          "minLength": 1
        },
        "imageIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        }
      },
      "required": [
        "projectId",
        "sceneId",
        "frameType",
        "splitTaskId",
        "imageIndex"
      ],
      "additionalProperties": false
