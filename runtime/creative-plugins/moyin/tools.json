  {
    "name": "moyin_angle_switch",
    "description": "托管参考图视角重绘：不是RunningHub App，可能收费，模型必须支持参考图；只在用户要求生成后调用",
    "inputSchema": {
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string",
          "minLength": 1
        },
        "referenceImage": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "type": "string",
          "enum": [
            "front",
            "front-right-quarter",
            "right-side",
            "back-right-quarter",
            "back",
            "back-left-quarter",
            "left-side",
            "front-left-quarter"
          ]
        },
        "elevation": {
          "type": "string",
          "enum": [
            "low-angle",
            "eye-level",
            "elevated",
            "high-angle"
          ]
        },
        "shotSize": {
          "type": "string",
          "enum": [
            "close-up",
            "medium-shot",
            "wide-shot"
          ]
        },
        "model": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "projectId",
        "referenceImage",
        "direction",
        "elevation",
        "shotSize"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "moyin_split_quad_grid",
