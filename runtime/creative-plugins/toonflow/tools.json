  {
    "name": "toonflow_generate_text",
    "description": "按成员授权文本模型生成 .txt/.md 文稿；支持有序 STRING、纯文本 FILE、能力已声明的 IMAGE 引用，保留人工稿和未知原任务。VIDEO 与需要解析缓存的非纯文本 FILE 暂不支持。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "project": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "references": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "dataType": {
                    "const": "STRING"
                  },
                  "value": {
                    "type": "string",
                    "maxLength": 1000000
                  }
                },
                "required": [
                  "dataType",
                  "value"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "dataType": {
                    "enum": [
                      "IMAGE",
                      "FILE"
                    ]
                  },
                  "value": {
                    "type": "object",
                    "properties": {
                      "url": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4096
                      },
                      "mimeType": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      }
                    },
                    "required": [
                      "url",
                      "mimeType"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "dataType",
                  "value"
                ],
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "required": [
        "project",
        "path",
        "prompt"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "toonflow_local_media",
    "description": "对 frameAnalysisNode 做本地抽帧/分镜/音轨提取、videoNode 做 extractAudio/separate/trim、imageNode 做宫格切分；保留原媒体、新增原生素材节点；立即返回 taskId，同 callId 不重做，不调用模型。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "project": {
          "type": "string",
          "minLength": 1
        },
        "canvas": {
          "type": "string",
          "minLength": 1
        },
        "node_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "frames",
            "video",
            "image-grid"
          ]
        },
        "options": {
          "type": "object",
          "properties": {
            "method": {
              "enum": [
                "adaptive",
                "content"
              ]
            },
            "threshold": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 255
            },
            "minSceneSeconds": {
              "type": "number",
              "minimum": 0,
              "maximum": 60
            },
            "frames": {
              "type": "boolean"
            },
            "clips": {
              "type": "boolean"
            },
            "audio": {
              "type": "boolean"
            },
            "action": {
              "enum": [
                "extractAudio",
                "separate",
                "trim"
              ]
            },
            "start": {
              "type": "number",
              "minimum": 0
            },
            "end": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "rows": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            },
            "columns": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "project",
        "canvas",
        "node_id",
        "kind",
        "options"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "toonflow_director",
    "description": "读取/选择已有导演方案、添加原生人偶、恢复旧方案输入指令或设置/重排/删除取景参数；不捕获WebGL画面、不调用AI、不渲染或导出。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "project": {
          "type": "string",
          "minLength": 1
        },
        "canvas": {
          "type": "string",
          "minLength": 1
        },
        "node_id": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "enum": [
            "read",
            "select_plan",
            "add_mannequin",
            "restore_instruction",
            "set_anchors",
            "reorder_anchors",
            "remove_anchor"
          ]
        },
        "plan_id": {
          "type": "string",
          "minLength": 1
        },
        "anchors": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object"
          }
        },
        "anchor_ids": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "anchor_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "project",
        "canvas",
        "node_id",
        "action"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "toonflow_generate_text_node",
    "description": "执行已保存的原生 textNode：按原生 promptModel、连线及 referenceOrder 读取绑定文稿与引用；仅文本、纯文本文件及授权图片，不猜视频能力。完整结果先保留，人工修改冲突不覆盖，未知任务不重投。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "project": {
          "type": "string",
          "minLength": 1
        },
        "canvas": {
          "type": "string",
          "minLength": 1
        },
        "node_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "project",
        "canvas",
        "node_id"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "toonflow_analyze_scenes",
    "description": "基于已保存的原生拉片结果，按官方时序图片抽样进行逐镜头分析与文本归纳；必须使用成员授权图片输入文本模型。每步完整响应保留，未知请求不重投，人工标注冲突不覆盖；不分析声音、不宣称完整视频理解。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "project": {
          "type": "string",
          "minLength": 1
        },
        "canvas": {
          "type": "string",
          "minLength": 1
        },
        "node_id": {
          "type": "string",
          "minLength": 1
        },
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "focus": {
          "type": "string",
          "maxLength": 2000
        }
      },
      "required": [
        "project",
        "canvas",
        "node_id",
        "model_id"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "toonflow_image_variant",
    "description": "按官方打光/多角度/全景纯合同，在原图旁创建合法生成草稿及原图连线；不自动生成、不渲染、不重绘。需成员授权图片输入模型，比例/尺寸必须明确支持，全景2:1或4:1不得降级。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "project": {
          "type": "string",
          "minLength": 1
        },
        "canvas": {
          "type": "string",
          "minLength": 1
        },
        "node_id": {
          "type": "string",
          "minLength": 1
        },
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "ratio": {
          "type": "string",
          "minLength": 1
        },
        "size": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "lighting",
            "multi-angle",
            "panorama"
          ]
        },
        "options": {
          "type": "object",
          "properties": {
            "azimuth": {
              "type": "number"
            },
            "elevation": {
              "type": "number"
            },
            "brightness": {
              "type": "number"
            },
            "lightColor": {
              "type": "string",
              "minLength": 1
            },
            "rimLight": {
              "type": "boolean"
            },
            "rimAzimuth": {
              "type": "number"
            },
            "rimElevation": {
              "type": "number"
            },
            "rimBrightness": {
              "type": "number"
            },
            "rimColor": {
              "type": "string",
              "minLength": 1
            },
            "preset": {
              "type": "string"
            },
            "smartMode": {
              "type": "boolean"
            },
            "smartDesc": {
              "type": "string"
            },
            "distance": {
              "type": "number"
            },
            "lens": {
              "enum": [
                "standard",
                "wide"
              ]
            },
            "viewMode": {
              "enum": [
                "orbit",
                "camera"
              ]
            },
            "mode": {
              "enum": [
                "sphere",
                "cylinder"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "project",
        "canvas",
        "node_id",
        "kind",
        "model_id",
        "options"
      ],
      "additionalProperties": false
    }
  }
]
