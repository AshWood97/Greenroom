  {
    "name": "drama_skills_import_source",
    "description": "从当前成员已上传的UTF-8文本资产导入原著；无需把整本文本经对话回传。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string"
        },
        "assetId": {
          "type": "string"
        }
      },
      "required": [
        "projectId",
        "assetId"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "drama_skills_register_benchmark",
    "description": "登记当前成员视频 Asset 为对标：明确允许用途、依据、外传许可和本轮问题；原片只存输入/对标，不进入正常交付。不调用外部模型。一个 referenceId 下多集使用同一登记；已有绑定不覆盖。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string"
        },
        "referenceId": {
          "type": "string",
          "pattern": "^REF-[A-Z0-9][A-Z0-9-]{0,59}$"
        },
        "episode": {
          "type": "integer",
          "minimum": 1
        },
        "assetId": {
          "type": "string"
        },
        "permittedUse": {
          "type": "string",
          "enum": [
            "study",
            "owned",
            "licensed"
          ]
        },
        "basis": {
          "type": "string"
        },
        "allowExternalModel": {
          "type": "boolean"
        },
        "question": {
          "type": "string"
        },
        "playbackSurface": {
          "type": "string"
        },
        "productionForm": {
          "type": "string"
        }
      },
      "required": [
        "projectId",
        "referenceId",
        "episode",
        "assetId",
        "permittedUse",
        "allowExternalModel",
        "question",
        "playbackSurface",
        "productionForm"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "drama_skills_run_breakdown",
    "description": "执行固定免费本地拆解任务，稳定 requestId 重复调用仅返回原任务；中断不自动重跑。measure 测量切点与拼图；audio 测有声/响度；subtitle-sheet 校准；subtitles 只测字形事件不认字；shots 从同源测量切片/抽帧；transcript 将提供的定时转写挂到测量副本；plan 估算本项目分集；profile 明选各系列每集一份任务同尺对照。不生成模型内容，不运行任意脚本/URL/额外摘要。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string"
        },
        "requestId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,80}$"
        },
        "operation": {
          "type": "string",
          "enum": [
            "measure",
            "audio",
            "subtitle-sheet",
            "subtitles",
            "shots",
            "transcript",
            "plan",
            "profile"
          ]
        },
        "referenceId": {
          "type": "string"
        },
        "episode": {
          "type": "integer",
          "minimum": 1
        },
        "sceneThreshold": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "band": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "color": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{6}$"
        },
        "measureTaskId": {
          "type": "string"
        },
        "audioTaskId": {
          "type": "string"
        },
        "transcript": {
          "type": "string"
        },
        "transcriptFormat": {
          "type": "string",
          "enum": [
            "srt",
            "vtt",
            "json"
          ]
        },
        "taskIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "string"
          }
        },
        "openingEpisodes": {
          "type": "integer",
          "minimum": 1
        },
        "speakers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "projectId",
        "requestId",
        "operation"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "drama_skills_get_breakdown",
    "description": "只读原拆解 requestId、状态、真实 JSON 结果和存在的私有工程文件；任务中断保留原结果目录，不自动重新提交。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string"
        },
        "requestId": {
          "type": "string"
        }
      },
      "required": [
        "projectId",
        "requestId"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "drama_skills_set_continuation_route",
    "description": "仅在创作者明确选择后持久保存续接方式。independent_starts 仍须 owner 补真实起始帧并改写接受正文；relay_external 仅移交创作者。待续接/不可提交不得投产。改变选择撤销未执行视频预览，不改变其他档案，也不等于生产确认。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string"
        },
        "route": {
          "type": "string",
          "enum": [
            "independent_starts",
            "relay_external"
          ]
        },
        "confirmed": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "projectId",
        "route",
        "confirmed"
      ],
      "additionalProperties": false
    }
  }
]
